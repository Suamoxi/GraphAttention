$MIXTURE

!---------------------------------------------------------------------------------------------------------------------
! Non reactive mixture AIR.
!---------------------------------------------------------------------------------------------------------------------
  mixture_name = AIR
  transport = simplified
  combustion_chemistry = no
  species_name = AIR
  species_Schmidt_number = 1.d0
  viscosity_law = sutherland
  mu_ref = 1.716d-5
  T_ref = 273.15d0
  viscosity_law_coeff = 110.6d0
  prandtl_number = 0.71d0


!---------------------------------------------------------------------------------------------------------------------
! Non reactive mixture AIR-C8H18
!---------------------------------------------------------------------------------------------------------------------
  mixture_name = AIR-C8H18
  transport = simplified
  combustion_chemistry = no
  species_name = AIR C8H18
  species_Schmidt_number = 0.75d0 0.75d0
  viscosity_law = sutherland
  mu_ref = 1.716d-5
  T_ref = 273.15d0
  viscosity_law_coeff = 110.6d0
  prandtl_number = 0.75d0
  fuel_tank_composition = 0.d0 1.d0
  oxydizer_tank_composition = 1.d0 0.d0


!---------------------------------------------------------------------------------------------------------------------
! Non reactive mixture AIR-C7H12
!---------------------------------------------------------------------------------------------------------------------
  mixture_name = AIR-C7H12
